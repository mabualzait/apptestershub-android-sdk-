<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:cardCornerRadius="12dp"
    app:cardElevation="8dp"
    app:cardBackgroundColor="@color/ath_surface">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <ProgressBar
            android:id="@+id/ath_progress_circular"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="8dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/ath_progress_day"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Day X/14"
                android:textColor="@color/ath_text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/ath_progress_timer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Recording: 0:00"
                android:textColor="@color/ath_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
